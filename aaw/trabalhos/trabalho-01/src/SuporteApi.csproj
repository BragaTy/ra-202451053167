<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>085b42b6-b43a-4df7-ab45-f600ee415732</UserSecretsId>
    <!-- Gera o XML dos comentários /// para o Swagger; 1591 = aviso de classe sem comentário. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="MongoDB.Driver" Version="3.13.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.0" />
  </ItemGroup>

</Project>
